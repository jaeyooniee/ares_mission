# ---- Large raw data (GitHub file size limit is 100 MB) ----
# Keep raw data in data/raw/ only and do not commit it. See docs/data_inventory.md for download instructions.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Raster / PDS raw formats (excluded in any folder)
*.tif
*.tiff
*.TIF
*.IMG
*.img
*.LBL
*.jp2
*.JP2
*.aux.xml
*.ovr
*.zip

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# ---- Node (if a build tool is used) ----
node_modules/
dist/

# ---- Secrets (NASA API keys, etc.) ----
.env
.env.*

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

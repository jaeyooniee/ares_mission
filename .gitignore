# ---- 대용량 원본 데이터 (GitHub 파일 한도 100MB) ----
# 원본은 data/raw/ 에만 두고 올리지 않음. 받는 방법은 docs/data_inventory.md 참고.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# 래스터·PDS 원본 형식 (어느 폴더에 있든 제외)
*.tif
*.tiff
*.TIF
*.IMG
*.img
*.LBL
*.jp2
*.JP2
*.aux.xml
*.ovr
*.zip

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# ---- Node (빌드 도구를 쓸 경우) ----
node_modules/
dist/

# ---- 비밀값 (NASA API 키 등) ----
.env
.env.*

# ---- 에디터 / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
